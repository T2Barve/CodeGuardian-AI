# ==============================================================================
# CodeGuardian AI — Production Environment Configuration (.env.production)
# Autonomous Multi-Agent Code Review & DevSecOps Platform
# ==============================================================================

# Application Environment & Logging
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-cryptographically-secure-64-character-random-key
ALLOWED_HOSTS=["codeguardian.ai","api.codeguardian.ai","localhost"]
CORS_ORIGINS=["https://codeguardian.ai","https://dashboard.codeguardian.ai"]

# PostgreSQL Database Configuration (High-Performance Pooling)
POSTGRES_USER=codeguardian
POSTGRES_PASSWORD=replace-with-ultra-strong-database-password
POSTGRES_DB=codeguardian_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://codeguardian:replace-with-ultra-strong-database-password@postgres:5432/codeguardian_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Queue & Broker Configuration (Password Protected)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://default:your_redis_password_here@redis:6379/0
REDIS_MAX_CONNECTIONS=50

# Vector Database (ChromaDB) Configuration
CHROMA_PERSIST_DIRECTORY=/app/data/chromadb

# GitHub App & Webhook Configuration
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_TOKEN=your_github_pat_here

# AI / LLM Provider Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Static Analysis Scanner Engine Toggles
ENABLE_SEMGREP=true
ENABLE_BANDIT=true
ENABLE_GITLEAKS=true
ENABLE_ESLINT=true
SCANNER_TIMEOUT_SECONDS=45

# Remediation Engine Sandbox Security Controls
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=1024
SANDBOX_MAX_PATCH_SIZE_KB=500
MAX_REQUEST_BODY_SIZE_MB=10

# Web Server & Performance Tuning
UVICORN_WORKERS=4
FRONTEND_PORT=80
